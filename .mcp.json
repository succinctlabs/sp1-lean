{
  "mcpServers": {
    "LeanExplore": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "lean-explore",
        "leanexplore",
        "mcp",
        "serve",
        "--backend",
        "local"
      ],
      "env": {}
    },
    "lean-lsp": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "lean-lsp-mcp"
      ],
      "env": {}
    }
  }
}