+/// Compile the constraints and interaction messages contributed by
+/// `ExecutionRecord::eval_public_values`. These are part of every Core shard proof but do not
+/// belong to any chip row, so they need a dedicated extraction entry point.
+#[allow(clippy::print_stdout)]
+fn compile_public_values(output_format: &OutputFormat) {
+    let machine = RiscvAir::<F>::machine();
+    let num_public_values = machine.num_pv_elts();
+    let mut builder = ConstraintCompiler::with_sizes(num_public_values, 0, 0);
+    <<RiscvAir<F> as MachineAir<F>>::Record as MachineRecord>::eval_public_values(&mut builder);
+
+    match output_format {
+        OutputFormat::Text => {
+            println!("Machine-level public-values constraints:");
+            println!("{}", builder.ast().to_string_pretty("   "));
+        }
+        OutputFormat::Json => {
+            println!("{}", serde_json::to_string_pretty(&builder.ast()).unwrap());
+        }
+        OutputFormat::Lean => {
+            let comps = builder.ast().to_lean_components(&Default::default());
+            let params =
+                vec![("publicValues".to_string(), format!("(Vector F {num_public_values})"))];
+            let mapping = HashMap::new();
+
+            println!();
+            println!("-- Generated Lean code for the machine-level public-values constraints");
+            println!();
+            println!("namespace PublicValuesOracle");
+            println!();
+            emit_list_def(
+                "asserts",
+                &params,
+                "List F",
+                &comps.bindings,
+                &comps.sub_asserts,
+                &comps.asserts,
+                &mapping,
+            );
+            println!();
+            emit_list_def(
+                "interactions",
+                &params,
+                "List (Interaction F)",
+                &comps.bindings,
+                &comps.sub_interactions,
+                &comps.interactions,
+                &mapping,
+            );
+            println!();
+            println!("end PublicValuesOracle");
+            println!();
+        }
+    }
+}
