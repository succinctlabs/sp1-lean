+/// Emit the machine shape directly from `RiscvAir::machine()`.  This is an extraction anchor, not
+/// a second hand-maintained registry: every cluster entry carries the exact runtime AIR name and
+/// its main/preprocessed widths.
+#[allow(clippy::print_stdout)]
+fn compile_profile_manifest() {
+    let machine = RiscvAir::<F>::machine();
+    let clusters = machine
+        .shape()
+        .chip_clusters
+        .iter()
+        .map(|cluster| {
+            cluster
+                .iter()
+                .map(|chip| {
+                    serde_json::json!({
+                        "name": chip.name(),
+                        "main_width": chip.width(),
+                        "preprocessed_width": chip.preprocessed_width(),
+                    })
+                })
+                .collect::<Vec<_>>()
+        })
+        .collect::<Vec<_>>();
+    let manifest = serde_json::json!({
+        "num_public_values": machine.num_pv_elts(),
+        "clusters": clusters,
+    });
+    println!("{}", serde_json::to_string_pretty(&manifest).unwrap());
+}
