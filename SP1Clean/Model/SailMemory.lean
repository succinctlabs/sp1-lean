      = .ok (.Ok v) s) :
    (translate_and_read_value (virtaddr.Virtaddr addr) width
        (MemoryAccessType.Load mem_payload.Data) false false false).run s
      = .ok (.Ok (physaddr.Physaddr (zero_extend (m := 64) addr), v)) s := by
